{
  "expo": {
    "name": "EventUs",
    "slug": "event-us",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.edu.urp.eventus",
      "buildNumber": "1"
    },
    "android": {
      "package": "pe.edu.urp.eventus",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "EventUs usa tu galería para portadas de eventos y recuerdos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5227c224-1042-452e-ac88-c6c538989b82"
      }
    },
    "owner": "jesusrazos-team"
  }
}
