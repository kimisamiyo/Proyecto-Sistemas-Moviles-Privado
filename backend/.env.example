USE_MEMORY_DB=false
# Si mongodb+srv falla en Windows (querySrv ECONNREFUSED), usa URI directa desde Atlas → Connect → Drivers
MONGO_URI=mongodb://user:pass@shard-00-00.xxxxx.mongodb.net:27017/SistemasMoviles?ssl=true&authSource=admin
JWT_SECRET=your_jwt_secret_here
PORT=5000

# Email (Gmail, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=app_password
